{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synqo.app/schemas/coordination-intent.v1.json",
  "title": "CoordinationIntent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "coordination-intent.v1"
    },
    "status": {
      "type": "string",
      "enum": ["OK", "NEEDS_CLARIFICATION", "UNSUPPORTED"]
    },
    "dateRange": {
      "$ref": "#/$defs/dateRange"
    },
    "hardConstraints": {
      "$ref": "#/$defs/hardConstraints"
    },
    "preferences": {
      "$ref": "#/$defs/preferences"
    },
    "candidateCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "proposedTime": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "clarification": {
      "$ref": "#/$defs/clarification"
    },
    "unsupportedReason": {
      "type": "string",
      "enum": [
        "OUT_OF_SCOPE",
        "REQUIRES_TIME_SLOTS",
        "REQUIRES_EXTERNAL_CALENDAR",
        "REQUIRES_RECURRENCE",
        "REQUIRES_CHAT_OR_NOTIFICATION",
        "AMBIGUOUS_INTENT",
        "UNSUPPORTED_LANGUAGE",
        "SAFETY_OR_PRIVACY"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "OK" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["dateRange"],
        "not": {
          "required": ["clarification"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "NEEDS_CLARIFICATION" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["clarification"],
        "not": {
          "required": ["unsupportedReason"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "UNSUPPORTED" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["unsupportedReason"]
      }
    }
  ],
  "$defs": {
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "hardConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minAvailable": {
          "type": "integer",
          "minimum": 0
        },
        "maxUnavailable": {
          "type": "integer",
          "minimum": 0
        },
        "excludedDates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "date"
          },
          "maxItems": 30
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferredWeekdays": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "MONDAY",
              "TUESDAY",
              "WEDNESDAY",
              "THURSDAY",
              "FRIDAY",
              "SATURDAY",
              "SUNDAY"
            ]
          },
          "maxItems": 7
        }
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "reason"],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "reason": {
          "type": "string",
          "enum": [
            "MISSING_DATE_RANGE",
            "AMBIGUOUS_DATE_RANGE",
            "AMBIGUOUS_TIMEZONE",
            "MISSING_REQUIRED_COUNT",
            "CONFLICTING_CONSTRAINTS",
            "UNCLEAR_REQUEST"
          ]
        }
      }
    }
  }
}
