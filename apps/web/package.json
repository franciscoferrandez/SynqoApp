{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format:check": "prettier --check 'src/**/*.{ts,html,css}' 'angular.json' 'package.json' 'tsconfig*.json' 'eslint.config.js' '.prettierrc' '.postcssrc.json'",
    "format:fix": "prettier --write 'src/**/*.{ts,html,css}' 'angular.json' 'package.json' 'tsconfig*.json' 'eslint.config.js' '.prettierrc' '.postcssrc.json'",
    "test:e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.25",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "angular-eslint": "21.4.0",
    "eslint": "10.12.0",
    "jsdom": "28.1.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "piscina": "5.3.2"
  }
}
