{
  "name": "synqo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.6.0 <13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm openapi:check && pnpm build",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @synqo/api migration:up",
    "db:up": "docker compose up -d postgres",
    "dev:api": "pnpm --filter @synqo/api dev",
    "dev:web": "pnpm --filter @synqo/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "openapi:check": "redocly lint synqo-documentation-v0.2/technical-design/18-api/openapi.yaml",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @synqo/web test:e2e",
    "test:integration": "pnpm --filter @synqo/api test:integration",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@redocly/cli": "^2.54.3",
    "prettier": "^3.9.9"
  }
}
