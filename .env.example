# Valores locales de desarrollo. No usar en despliegues.
POSTGRES_DB=synqo
POSTGRES_TEST_DB=synqo_test
POSTGRES_USER=synqo
POSTGRES_PASSWORD=synqo-local
POSTGRES_PORT=5433
API_PORT=8000
APP_ENV=dev
APP_SECRET=local-only-synqo-secret
APP_PUBLIC_URL=http://localhost:4200
TEAM_DELETION_RETENTION_DAYS=90
# Por defecto: desarrollo/preproducción 2 equipos cada 60 min; producción 5 cada 120 min.
# Los overrides son independientes; vacíos conservan el valor del entorno.
SYNQO_DEPLOYMENT_ENV=development
TEAM_CREATION_LIMIT=
TEAM_CREATION_WINDOW_MINUTES=
# Valores vacíos conservan el default del entorno; modos de correo: hidden, demo, send.
TEAM_CREATION_EMAIL_MODE=
DEMO_PANEL_ENABLED=
DEMO_RESET_SCHEDULE_ENABLED=
# Secreto local; genera uno con: openssl rand -hex 32
DEMO_ACCESS_SECRET=
# Debe estar definida; déjala vacía hasta inicializar los equipos demo.
DEMO_TEAM_IDS=
DEMO_DATABASE_HOST=database
# Clave base64 de 32 bytes para proteger el correo y el enlace pendientes: openssl rand -base64 32
# MAIL_EVENT_KEY=
MAIL_EVENT_TTL_SECONDS=1800
MAILPIT_UI_PORT=8025
