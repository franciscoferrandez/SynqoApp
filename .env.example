# Valores locales de desarrollo. No usar en despliegues.
POSTGRES_DB=synqo
POSTGRES_TEST_DB=synqo_test
POSTGRES_USER=synqo
POSTGRES_PASSWORD=synqo-local
POSTGRES_PORT=5433
API_PORT=8000
APP_ENV=dev
APP_SECRET=local-only-synqo-secret
APP_PUBLIC_URL=http://localhost:4200
TEAM_DELETION_RETENTION_DAYS=90
# Correo opcional al crear equipos. En local puede apagarse para probar el fallback.
TEAM_CREATION_EMAIL_ENABLED=true
# Clave base64 de 32 bytes para proteger el correo y el enlace pendientes: openssl rand -base64 32
# MAIL_EVENT_KEY=
MAIL_EVENT_TTL_SECONDS=1800
MAILPIT_UI_PORT=8025
